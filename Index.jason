{
  "name": "sol-copytrade-signal-bot",
  "version": "1.0.0",
  "description": "Watches a Solana wallet for buys on pump.fun/Raydium, applies pre-call risk filters, sends Telegram buy signals on ATH-dip recovery, and tracks post-call performance for a batched report.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
